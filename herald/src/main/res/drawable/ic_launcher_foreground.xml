<?xml version="1.0" encoding="utf-8"?>
<!--
    A herald's trumpet with its banner: the app announces what is allowed
    through, which is where the name comes from.

    Adaptive icon foreground. The viewport is 108dp but launchers mask it down to
    a shape inscribed in the middle 66dp, so every point here stays inside a
    circle of radius ~32 around (54,54) — a horizontal trumpet was wide enough to
    have its bell cropped off, hence the diagonal. One colour throughout, so the
    same drawable serves as the themed (monochrome) layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tube, running from the mouthpiece up to the bell. -->
    <path
        android:fillColor="#F7C948"
        android:pathData="M35.5,71.5 L64.5,42.5 L59.5,37.5 L30.5,66.5 Z" />

    <!-- Bell, flaring to the upper right. -->
    <path
        android:fillColor="#F7C948"
        android:pathData="M64.5,42.5 L77.8,39.8 L62.2,24.2 L59.5,37.5 Z" />

    <!-- Mouthpiece. -->
    <path
        android:fillColor="#F7C948"
        android:pathData="M33,63.2 a5.8,5.8 0 1,0 0.1,0 Z" />

    <!-- Banner hanging from the tube, swallow-tailed. -->
    <path
        android:fillColor="#F7C948"
        android:pathData="M37,55 L59,55 L59,78 L48,71 L37,78 Z" />
</vector>
