<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Herald" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Honoured up to API 34. From API 35 the bar is always transparent and
             this is ignored; every screen instead pads itself by the status bar
             inset and paints that strip with the same colour. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/toolbar_background</item>

        <!-- Day: the strips under both bars are the light toolbar colour, so the
             bar icons have to be dark. The night variant of this file flips
             both. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
