<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Herald" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Honoured up to API 34. From API 35 the bar is always transparent and
             this is ignored; every screen instead pads itself by the status bar
             inset and paints that strip with the same colour. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/toolbar_background</item>

        <!-- Both strips are toolbar-coloured on every screen, so the bar icons
             have to stay light in day mode too. Without this the platform picks
             them from the theme and draws dark icons on a dark bar. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
