{
  "manifest_version": 2,
  "name": "herald content filter",
  "version": "1.0",
  "description": "Blocks subresource requests to filtered domains.",
  "applications": {
    "gecko": {
      "id": "blocklist@herald.drawbridge.app"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
