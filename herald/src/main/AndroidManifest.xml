<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Reads which policy and which options the parent chose, from drawbridge.
        The permission is declared by drawbridge at `signature` level, so this is
        granted only when both apps carry the same signing key — and simply never
        granted on a phone where drawbridge is not installed, which is the
        standalone browser and works fine.
    -->
    <uses-permission android:name="app.drawbridge.permission.READ_SELECTION" />

    <!--
        Package visibility: without this, querying drawbridge's provider returns
        nothing at all on API 30+, and the browser would silently filter on the
        document's defaults on a managed device.
    -->
    <queries>
        <provider android:authorities="app.drawbridge.dpc.selection" />
    </queries>

    <application
        android:name=".HeraldApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Herald">

        <activity
            android:name=".BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|orientation|screenSize|layoutDirection|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Registers herald as a browser. On a drawbridge-managed device this is
            also what addPersistentPreferredActivity points at, so tapped links
            land here rather than in a browser that is about to be removed.
        -->
        <activity
            android:name=".IntentReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/xhtml+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/menu_settings" />

        <activity
            android:name=".history.HistoryActivity"
            android:exported="false"
            android:label="@string/menu_history" />

        <activity
            android:name=".bookmarks.BookmarksActivity"
            android:exported="false"
            android:label="@string/menu_bookmarks" />

        <activity
            android:name=".logins.LoginsActivity"
            android:exported="false"
            android:label="@string/menu_passwords" />

        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="Instantiatable" />

        <service
            android:name=".media.MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable" />
    </application>
</manifest>
