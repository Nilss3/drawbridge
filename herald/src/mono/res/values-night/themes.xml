<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Mono's night theme. See src/mono/res/values/themes.xml. -->
    <style name="Theme.Herald" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@color/toolbar_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Neutral surfaces; see values/themes.xml. -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_background</item>
        <item name="colorSurfaceBright">@color/app_background</item>
        <item name="colorSurfaceDim">@color/app_surface_container</item>
        <item name="colorSurfaceContainerLowest">@color/app_background</item>
        <item name="colorSurfaceContainerLow">@color/app_surface_container</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_high</item>

        <item name="colorPrimary">#FFCFCFCF</item>
        <item name="colorOnPrimary">#FF141414</item>
        <item name="colorPrimaryContainer">#FF3F3F3F</item>
        <item name="colorOnPrimaryContainer">#FFF2F2F2</item>
        <item name="colorSecondary">#FFB0B0B0</item>
        <item name="colorOnSecondary">#FF141414</item>
        <item name="colorSecondaryContainer">#FF3A3A3A</item>
        <item name="colorOnSecondaryContainer">#FFF2F2F2</item>
        <item name="colorTertiary">#FFC0C0C0</item>
        <item name="colorOnTertiary">#FF141414</item>
    </style>
</resources>
