<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Mono's theme, overriding src/main's.

        The greyscale filter reaches the engine's surface and the toolbar, but
        not the app menu: that is a popup in its own window, so Material's accent
        colour came through it and the Reader view switch sat there bright purple
        on an otherwise monochrome screen. A filter cannot reach it and should
        not have to — a menu's colours come from the theme, so the theme is where
        mono states them.

        **The surfaces below are why this file is a trap.** Overriding a style by
        name replaces it outright rather than adding to it, so when src/main
        gained its neutral surfaces this file silently kept Material 3's
        purple-tinted ones — #FEF7FF by day, on the one edition whose whole
        premise is that there is no colour on screen. It showed behind the pause
        screen, Settings, History, Downloads and Bookmarks, and the greyscale
        filter cannot reach any of them: it filters the engine's surface, and
        these are the app's own views.

        Everything else is src/main's Theme.Herald verbatim; restating it is the
        cost of a flavour overriding a style rather than extending one — and
        anything added there has to be added here in the same breath.
    -->
    <style name="Theme.Herald" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@color/toolbar_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Mono's own greys, not src/main's: those carry a faint blue in the
             containers (#F9F9FB), which is still a colour. -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_background</item>
        <item name="colorSurfaceBright">@color/app_background</item>
        <item name="colorSurfaceDim">@color/app_surface_container</item>
        <item name="colorSurfaceContainerLowest">@color/app_background</item>
        <item name="colorSurfaceContainerLow">@color/app_surface_container</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_high</item>

        <item name="colorPrimary">#FF3A3A3A</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFD9D9D9</item>
        <item name="colorOnPrimaryContainer">#FF101010</item>
        <item name="colorSecondary">#FF5A5A5A</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorSecondaryContainer">#FFE2E2E2</item>
        <item name="colorOnSecondaryContainer">#FF101010</item>
        <item name="colorTertiary">#FF4A4A4A</item>
        <item name="colorOnTertiary">#FFFFFFFF</item>
    </style>
</resources>
