<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Mono's chrome, overriding src/main's day palette.

        The pages are drained of colour by GreyscaleIntegration, which filters
        the engine's surface and so leaves the chrome untouched. A coloured
        toolbar above a monochrome page would be the one bright thing on screen,
        which is the opposite of the point, so the chrome is stated in grey here
        rather than left to inherit.

        The night variant is in values-night.
    -->
    <color name="toolbar_background">#FFF2F2F2</color>
    <color name="toolbar_text">#FF101010</color>
    <color name="toolbar_hint">#FF6B6B6B</color>
    <color name="menu_icon">#FF101010</color>

    <color name="tab_item_background">#FFFFFFFF</color>
    <color name="tab_item_selected_background">#FFDCDCDC</color>
    <color name="tab_item_text">#FF101010</color>
    <color name="tab_item_url">#FF6B6B6B</color>

    <color name="mozac_ui_tabcounter_default_tint">@color/toolbar_text</color>
    <color name="mozac_ui_tabcounter_default_text">@color/toolbar_text</color>

    <!-- The theme's surfaces: white, and greys with no hue in them at all.
         src/main's are a shade blue (#F9F9FB), which is a colour, and on this
         edition that is the one thing a surface may not be. -->
    <color name="app_background">#FFFFFFFF</color>
    <color name="app_surface_container">#FFF2F2F2</color>
    <color name="app_surface_container_high">#FFE6E6E6</color>
</resources>
