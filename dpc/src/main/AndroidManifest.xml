<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Lets herald read which policy and options the parent chose. `signature`
        means only a package signed with drawbridge's own release key can hold
        it, which is herald and herald mono and nothing else — no declaration on
        the phone, and no user prompt, can grant it to anything else.
    -->
    <permission
        android:name="app.drawbridge.permission.READ_SELECTION"
        android:label="@string/permission_read_selection"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Removing blocked apps and installing our own updates, both through
        PackageInstaller. What makes those silent — no confirmation dialog — is
        Device Owner status, not a permission.

        Note that android.permission.DELETE_PACKAGES is deliberately *not*
        declared: it is signature|privileged, so a sideloaded app can never be
        granted it, and PackageInstaller.uninstall works without it for a Device
        Owner (verified on device).

        android.permission.REQUEST_INSTALL_PACKAGES is *not* declared either, and
        that one was removed rather than never added. It governs the user-facing
        unknown-sources flow, which a Device Owner committing its own
        PackageInstaller session never enters — so it bought nothing, while Play
        Protect reads it on an app with no Play reputation and refuses to let
        that app be installed at all ("this app can install potentially harmful
        apps without your permission"). Declaring it is what stopped drawbridge
        updating itself on a phone with a Google account.

        Verified on the provisioned emulator, 2026-08-09: with the line gone, the
        Device Owner still installed herald 6 → 8 in place and herald mono from
        absent, both silently, both through PackageInstaller.

        REQUEST_DELETE_PACKAGES below is very likely unnecessary for the same
        reason. It is kept for now so the Play Protect result has one variable.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        A <queries> declaration cannot express what this needs: the whole point
        is to notice packages nobody has heard of yet, so there is no list to
        declare. Granted automatically at install time; the Play Store
        declaration form it normally requires does not apply, because drawbridge
        is distributed as a signed APK from GitHub rather than through Play.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".DrawbridgeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drawbridge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LockActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title" />

        <activity
            android:name=".ui.RemoveActivity"
            android:exported="false"
            android:label="@string/remove_title" />

        <!--
            Below API 33 AppCompat stores the per-app locale itself, but only if
            this metadata says so. Without it the language picker works until the
            process dies and then silently forgets.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            The two activities the platform hands off to during QR / NFC
            provisioning, required since Android 11. Without them the setup
            wizard downloads the APK, verifies its signature, shows "this device
            belongs to your organization" and then dies with "Something went
            wrong" — the failure that had been misread as Play Protect's DPC
            allowlist until a Moto G15 got past the download on 2026-08-07.

            `dpm set-device-owner` never launches either one, which is why this
            was invisible to every emulator run and every adb provisioning.

            Exported with no permission on purpose: both hand back a constant and
            finish, so there is no privilege for a caller to gain. Requiring
            BIND_DEVICE_ADMIN here would be guessing about which system component
            launches them, on the one path that costs a factory reset to retest.
        -->
        <activity
            android:name=".admin.ProvisioningModeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.PolicyComplianceActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The component name here is part of the provisioning command
            (`dpm set-device-owner <pkg>/<this>`) and of the QR payload, so it
            must not be renamed once any device has been provisioned.
        -->
        <receiver
            android:name=".admin.DrawbridgeDeviceAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Read-only, and exported on purpose: herald is a separate app and has
            no other way to learn what the parent chose. readPermission alone —
            no writePermission — because there is deliberately no way to write.
        -->
        <provider
            android:name=".policy.SelectionProvider"
            android:authorities="app.drawbridge.dpc.selection"
            android:exported="true"
            android:readPermission="app.drawbridge.permission.READ_SELECTION" />

        <receiver
            android:name=".apps.PackageRemovalReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!--
            Services that extend VpnService still need a foreground service type
            from Android 14; "specialUse" with a stated subtype is the category
            that fits a device-wide content filter.
        -->
        <service
            android:name=".vpn.DnsFilterService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device-wide DNS content filter for a managed device" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
