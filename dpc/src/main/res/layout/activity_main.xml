<?xml version="1.0" encoding="utf-8"?>
<!--
    The configuration screen: everything the parent decides, in the order they
    decide it.

    Language is first, above the welcome rather than under it, because every word
    below it is a word they have to read — including the illustration's caption
    and the policy's own description, which come out of the signed document.

    The policy cards and the option switches are inflated into their containers
    at runtime from item_policy.xml and item_option.xml, because both lists come
    out of that document rather than out of this file.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/TextAppearance.Drawbridge.SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language_heading" />

        <!-- No hint: the section heading above already says "Language", and a
             floating label would say it a second time. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="28dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/languageField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Shown whole rather than cropped to a band. The master is square and
            composed as one picture: the reader on his bench at the bottom left
            and the monsters at the bottom right are the point of it, and a
            centre crop to a letterbox takes the spire tips off the top and the
            feet off the bottom. wrap_content with adjustViewBounds lets the
            height follow the width, which costs nothing but a little scrolling
            on a phone screen.
        -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/welcome_scene_description"
            android:scaleType="fitCenter"
            android:src="@drawable/welcome_scene"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Drawbridge.Hero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:paddingBottom="8dp"
            android:text="@string/welcome_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:paddingBottom="28dp"
            android:text="@string/welcome_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            style="@style/TextAppearance.Drawbridge.SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/policy_heading" />

        <LinearLayout
            android:id="@+id/policyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp" />

        <TextView
            style="@style/TextAppearance.Drawbridge.SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/options_heading" />

        <TextView
            android:id="@+id/optionsExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:paddingBottom="8dp"
            android:text="@string/options_explanation"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <LinearLayout
            android:id="@+id/optionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp" />

        <TextView
            android:id="@+id/optionsFootnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:alpha="0.75"
            android:text="@string/options_footnote"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            style="@style/TextAppearance.Drawbridge.SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_heading" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/protectedSinceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/ownershipStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/filterStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/policyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/status_restrictions_heading"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/restrictionsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <Button
                android:id="@+id/lockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_lock" />

            <Button
                android:id="@+id/refreshButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_refresh" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
