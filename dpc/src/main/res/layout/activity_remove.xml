<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!--
            No heading. The action bar already carries `remove_title` as this
            activity's label, and until 2026-09-10 this screen said the same
            words again directly under it. That was tolerable while both read
            "Deactivate drawbridge restrictions" and merely looked repetitive;
            with the shorter title it is the same three words twice in the top
            eighth of the screen. What a parent needs first here is the warning,
            so the warning is what they get.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:text="@string/remove_explanation"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/removeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_action" />

        <Button
            android:id="@+id/cancelButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_cancel" />
    </LinearLayout>
</ScrollView>
