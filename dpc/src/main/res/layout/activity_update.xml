<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/update_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/updateVersions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!--
            What the release says about itself, between the version line and the
            paragraph about Play Protect.

            Above the buttons, not below the pictured walk. This is an input to
            the decision the buttons ask for — the parent is being asked to take
            an action drawbridge cannot take for itself, and this is the only
            place they are told what for. Under the screenshots it would be a
            changelog somebody scrolls to afterwards, which is a different and
            much less useful thing.

            Both views start gone and are shown together: a document with no
            notes shows neither, rather than a heading standing over nothing.
        -->
        <TextView
            android:id="@+id/updateNotesHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/update_notes_heading"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="@string/update_why_blocked"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/playProtectButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_open_play_protect" />

        <Button
            android:id="@+id/updateInstallButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/update_install" />

        <!--
            The Play Protect walk, pictured, under the two buttons rather than
            above them.

            Above them it would put roughly a screenful of images between the
            one paragraph and the thing that paragraph says to press, and this
            screen is reached twice: once to pause Play Protect and once, coming
            back from it, to install. Somebody returning for the second visit
            wants the button, not the pictures again. Below, the buttons are the
            first thing after the words, and the pictures are where a parent who
            did not find the setting will scroll.

            They carry no heading of their own: the paragraph ends by pointing
            at them, which is the only introduction they need.

            Each is capped rather than stretched: these are screenshots 621 to
            756 px wide, so match_parent on a 1080 px phone would be upscaling
            them by a third to no purpose. adjustViewBounds keeps the aspect
            ratio at whatever width they end up.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingBottom="6dp"
            android:text="@string/update_shot_1"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/update_shot_1"
            android:maxWidth="300dp"
            android:scaleType="fitStart"
            android:src="@drawable/play_protect_1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:text="@string/update_shot_2"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/update_shot_2"
            android:maxWidth="300dp"
            android:scaleType="fitStart"
            android:src="@drawable/play_protect_2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:text="@string/update_shot_3"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/update_shot_3"
            android:maxWidth="300dp"
            android:scaleType="fitStart"
            android:src="@drawable/play_protect_3" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
