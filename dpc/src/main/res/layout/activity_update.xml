<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/update_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/updateVersions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/update_why_blocked"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/update_steps_heading"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="@string/update_steps"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/playProtectButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_open_play_protect" />

        <Button
            android:id="@+id/updateInstallButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/update_install" />

        <!--
            The Play Protect walk, pictured, under the two buttons rather than
            above them.

            Above them it would put roughly a screenful of images between the
            instructions and the thing they tell you to press, and this screen
            is reached twice: once to pause Play Protect and once, coming back
            from it, to install. Somebody returning for the second visit wants
            the button, not the pictures again. Below, the buttons are the first
            thing on the screen after the words, and the pictures are where a
            parent who did not find the setting will scroll.

            Each is capped rather than stretched: these are screenshots 621 to
            756 px wide, so match_parent on a 1080 px phone would be upscaling
            them by a third to no purpose. adjustViewBounds keeps the aspect
            ratio at whatever width they end up.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingBottom="4dp"
            android:text="@string/update_shots_heading"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:text="@string/update_shot_1"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/update_shot_1"
            android:maxWidth="300dp"
            android:scaleType="fitStart"
            android:src="@drawable/play_protect_1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:text="@string/update_shot_2"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/update_shot_2"
            android:maxWidth="300dp"
            android:scaleType="fitStart"
            android:src="@drawable/play_protect_2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:text="@string/update_shot_3"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/update_shot_3"
            android:maxWidth="300dp"
            android:scaleType="fitStart"
            android:src="@drawable/play_protect_3" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.75"
            android:text="@string/update_turn_back_on"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
