<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        From API 35 the system bars are transparent and drawn over the window, so
        their icons have to be dark against this theme's light background. The
        night variant of this file flips both back.
    -->
    <style name="Theme.Drawbridge" parent="Theme.Material3.DayNight">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!--
            The website's green, as colour roles. Baseline Material 3 is purple,
            and until 2026-08-10 that is what this app was: the framework's
            default rather than anyone's decision. See colors.xml.

            Dynamic colour is deliberately not switched on. On a phone whose
            wallpaper the child chose, Material You would tint the one screen
            that is supposed to look like it belongs to the parent.
        -->
        <item name="colorPrimary">@color/green_wood</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_slate_dark</item>

        <item name="colorSecondary">@color/green_slate</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/green_slate_dark</item>

        <item name="colorTertiary">@color/green_olive</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:colorBackground">@color/green_cream</item>
        <item name="colorOnBackground">@color/green_ink</item>
        <item name="colorSurface">@color/green_paper</item>
        <item name="colorOnSurface">@color/green_ink</item>
        <item name="colorSurfaceVariant">@color/green_line</item>
        <item name="colorOnSurfaceVariant">@color/green_ink_soft</item>

        <item name="colorSurfaceContainerLowest">@color/green_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/green_surface_low</item>
        <item name="colorSurfaceContainer">@color/green_surface</item>
        <item name="colorSurfaceContainerHigh">@color/green_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/green_surface_highest</item>
        <item name="colorSurfaceDim">@color/green_surface_dim</item>
        <item name="colorSurfaceBright">@color/green_surface_bright</item>

        <item name="colorOutline">@color/green_ink_soft</item>
        <item name="colorOutlineVariant">@color/green_line</item>

        <item name="colorError">@color/green_rust</item>
        <item name="colorOnError">@color/white</item>
    </style>

    <!-- The configuration screen is one long column of sections, and this is what
         separates them: the same heading with the same space around it, in every
         one.

         It used to be titleMedium in the body colour, which on a screen where
         every card also carries a title read as one more line of text — "Policy"
         looked like a label for the cards rather than the start of a section.
         Four things now say "new section" together: the rule above it, the space
         that rule sits in, the weight, and the accent colour. The colour is a
         theme attribute, so it still needs no values-night of its own. -->
    <style name="TextAppearance.Drawbridge.SectionHeading" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/section_rule</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- The first heading on the screen, which has nothing above it to be
         separated from: a rule directly under the title bar reads as a stray
         line rather than as a boundary. Same heading otherwise. -->
    <style name="TextAppearance.Drawbridge.SectionHeading.First" parent="TextAppearance.Drawbridge.SectionHeading">
        <item name="android:background">@null</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <!-- Rounds the illustration to match the cards under it. -->
    <style name="ShapeAppearance.Drawbridge.Hero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
