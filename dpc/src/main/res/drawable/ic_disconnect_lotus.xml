    <group android:pivotX="12" android:pivotY="19" android:rotation="-72">
        <path android:fillColor="@android:color/white"
            android:pathData="M12,19c-1.3,-1.8 -1.8,-4.2 -1.8,-6.2 0,-1.8 0.7,-3.4 1.8,-4.8 1.1,1.4 1.8,3 1.8,4.8 0,2 -0.5,4.4 -1.8,6.2z" />
    </group>
    <group android:pivotX="12" android:pivotY="19" android:rotation="-40">
        <path android:fillColor="@android:color/white"
            android:pathData="M12,19c-1.3,-1.8 -1.8,-4.2 -1.8,-6.2 0,-1.8 0.7,-3.4 1.8,-4.8 1.1,1.4 1.8,3 1.8,4.8 0,2 -0.5,4.4 -1.8,6.2z" />
    </group>
    <group android:pivotX="12" android:pivotY="19" android:rotation="0">
        <path android:fillColor="@android:color/white"
            android:pathData="M12,19c-1.3,-1.8 -1.8,-4.2 -1.8,-6.2 0,-1.8 0.7,-3.4 1.8,-4.8 1.1,1.4 1.8,3 1.8,4.8 0,2 -0.5,4.4 -1.8,6.2z" />
