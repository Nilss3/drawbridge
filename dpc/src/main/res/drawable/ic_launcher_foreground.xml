<?xml version="1.0" encoding="utf-8"?>
<!--
    A raised drawbridge: two gate towers, both leaves up on their chains, water
    below. The same motif herald shows on its block page.

    Adaptive icon foreground. The viewport is 108dp and launchers may mask
    anything outside the middle 66dp, so the drawing stays inside roughly
    x/y 21..87. Strokes rather than fills, and one colour, so the same drawable
    serves as the themed (monochrome) layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Towers. -->
    <path
        android:pathData="M37.5,69.7 L37.5,30.1 M70.5,69.7 L70.5,30.1"
        android:strokeColor="#F2F2F7"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- Approach decks. -->
    <path
        android:pathData="M21,59.8 L37.5,59.8 M70.5,59.8 L87,59.8"
        android:strokeColor="#F2F2F7"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- The two leaves, raised. -->
    <path
        android:pathData="M37.5,59.8 L50.7,40 M70.5,59.8 L57.3,40"
        android:strokeColor="#F2F2F7"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- Chains. -->
    <path
        android:pathData="M37.5,33.4 L50.7,41.9 M70.5,33.4 L57.3,41.9"
        android:strokeColor="#F2F2F7"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Water. -->
    <path
        android:pathData="M21,78 q5.3,-4.6 10.6,0 t10.6,0 t10.6,0 t10.6,0 t10.6,0"
        android:strokeColor="#F2F2F7"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
</vector>
