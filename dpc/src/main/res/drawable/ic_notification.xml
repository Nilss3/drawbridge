<?xml version="1.0" encoding="utf-8"?>
<!--
    The small icon for a policy notice in the shade.

    Its own drawable rather than `ic_info`, for two reasons. That one carries
    `android:tint="?attr/colorPrimary"`, and a theme attribute has nothing to
    resolve against when the system draws a notification outside the app's
    context. And it is the *outline* weight, which is right on a card at 24dp
    and disappears at the ~18dp a status-bar icon is drawn at: Android masks a
    small icon to its alpha channel and paints it a flat colour, so a hairline
    ring becomes a smudge. Filled, it stays a recognisable dot with a mark in it.

    Standard Material "info", the filled variant — the same glyph family as the
    outline used on the cards, so the shade and the screen agree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,17h-2v-6h2v6zM13,9h-2L11,7h2v2z" />
</vector>
