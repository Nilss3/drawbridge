  "profiles": [
    {
      "id": "default",
      "name": "Default policy",
      "subtitle": "Keeps out the toxic internet",
      "description": "Keeps out algorithmic social media, adult sites, gambling, ads, dating apps, games, and AI companions. The only search engines available are Google, DuckDuckGo, Bing, and Kagi. The only browsers are herald (recommended), herald mono, Chrome, Firefox Focus, Vivaldi, Comet and Via.",
      "name_i18n": {
        "nl": "Standaardbeleid",
        "fr": "Politique par d\u00e9faut"
      },
      "subtitle_i18n": {
        "nl": "Houdt het toxische internet buiten",
        "fr": "Tient l'internet toxique \u00e0 distance"
      },
      "description_i18n": {
        "nl": "Houdt algoritmische sociale media, pornosites, gokken, advertenties, datingapps, games en AI-gezelschapsapps buiten. De enige beschikbare zoekmachines zijn Google, DuckDuckGo, Bing en Kagi. De enige browsers zijn herald (aanbevolen), herald mono, Chrome, Firefox Focus, Vivaldi, Comet en Via.",
        "fr": "Tient \u00e0 distance les r\u00e9seaux sociaux algorithmiques, les sites pornographiques, les jeux d'argent, la publicit\u00e9, les applications de rencontre, les jeux et les compagnons IA. Les seuls moteurs de recherche disponibles sont Google, DuckDuckGo, Bing et Kagi. Les seuls navigateurs sont herald (recommand\u00e9), herald mono, Chrome, Firefox Focus, Vivaldi, Comet et Via."
      },
      "recommended_age": 14
    }
  ],
  "default_profile": "default",
  "options": [
    {
      "id": "whatsapp",
      "name": "Allow WhatsApp",
      "subject": "WhatsApp",
      "recommended_age": 14,
      "description": "WhatsApp carries privacy risks, has toxic social media features and an annoying chatbot. Signal is always allowed on this device, even though as a group chat app with risk of cyberbullying we also recommend 14+ and/or parental guidance. Switching this off does not uninstall the app: it is suspended and hidden, and comes back with all its chats and media intact if you switch it on again. If you would rather it were really gone, uninstall it yourself before locking.",
      "default_enabled": true,
      "exempt_packages": [
        "com.whatsapp",
        "com.whatsapp.w4b"
      ],
      "allowed_domains": [
        "whatsapp.com",
        "whatsapp.net",
        "wa.me"
      ],
      "name_i18n": {
        "nl": "WhatsApp toestaan",
        "fr": "Autoriser WhatsApp"
      },
      "description_i18n": {
        "nl": "WhatsApp brengt privacyrisico's mee, heeft toxische socialemediafuncties en een vervelende chatbot. Signal is op dit toestel altijd toegelaten, al raden we ook daar 14+ en/of ouderlijke begeleiding aan: als groepschat-app draagt het een risico op cyberpesten. Dit uitzetten verwijdert de app niet: ze wordt opgeschort en verborgen, en komt met al haar gesprekken en media intact terug zodra je ze weer aanzet. Wil je ze echt kwijt, verwijder ze dan zelf voor je vergrendelt.",
        "fr": "WhatsApp comporte des risques pour la vie priv\u00e9e, des fonctions de r\u00e9seau social toxiques et un chatbot p\u00e9nible. Signal est toujours autoris\u00e9 sur cet appareil, m\u00eame si nous y recommandons aussi 14+ et/ou un accompagnement parental : en tant qu'application de discussion de groupe, elle comporte un risque de cyberharc\u00e8lement. D\u00e9sactiver cette option ne d\u00e9sinstalle pas l'application : elle est suspendue et masqu\u00e9e, et revient avec toutes ses conversations et tous ses m\u00e9dias intacts si vous la r\u00e9activez. Si vous pr\u00e9f\u00e9rez qu'elle disparaisse vraiment, d\u00e9sinstallez-la vous-m\u00eame avant de verrouiller."
      },
      "subject_i18n": {
        "nl": "WhatsApp",
        "fr": "WhatsApp"
      }
    },
    {
      "id": "youtube",
      "name": "Allow YouTube",
      "subject": "YouTube",
      "recommended_age": 16,
      "description": "YouTube's recommendation feed and Shorts are built to keep you watching, which is why it is blocked by default. Switching this on restores YouTube and its family (Kids, TV, Creator Studio, Music) and turns Google's own Restricted Mode on for the YouTube app and for the browser. The phone enforces that, so it cannot be switched off from inside YouTube. In herald, Shorts open as ordinary videos.",
      "default_enabled": true,
      "exempt_packages": [
        "com.google.android.youtube",
        "com.google.android.apps.youtube.kids",
        "com.google.android.youtube.tv",
        "com.google.android.apps.youtube.creator",
        "com.google.android.apps.youtube.unplugged",
        "com.google.android.apps.youtube.music"
      ],
