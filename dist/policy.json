  "profiles": [
    {
      "id": "default",
      "name": "Default policy",
      "subtitle": "Keeps out the toxic internet (+14)",
      "description": "Access refused to adult sites, gambling, ads, algorithmic social media, harmful games and AI companions, as well as search engines other than Google, DuckDuckGo, Bing, Ecosia and Kagi. The rest of the internet is cautiously welcome.",
      "name_i18n": {
        "nl": "Standaardbeleid",
        "fr": "Politique par d\u00e9faut"
      },
      "subtitle_i18n": {
        "nl": "Houdt het toxische internet buiten (+14)",
        "fr": "Tient l'internet toxique \u00e0 distance (+14)"
      },
      "description_i18n": {
        "nl": "Toegang geweigerd tot pornosites, gokken, advertenties, algoritmische sociale media, schadelijke games en AI-gezelschapsapps, en ook tot andere zoekmachines dan Google, DuckDuckGo, Bing, Ecosia en Kagi. De rest van het internet is voorzichtig welkom.",
        "fr": "Acc\u00e8s refus\u00e9 aux sites pornographiques, aux jeux d'argent, \u00e0 la publicit\u00e9, aux r\u00e9seaux sociaux algorithmiques, aux jeux nocifs et aux compagnons IA, ainsi qu'aux moteurs de recherche autres que Google, DuckDuckGo, Bing, Ecosia et Kagi. Le reste d'internet est prudemment le bienvenu."
      }
    }
  ],
  "default_profile": "default",
  "options": [
    {
      "id": "whatsapp",
      "name": "Allow WhatsApp",
      "recommended_age": 14,
      "description": "WhatsApp carries privacy risks, has toxic social media features and an annoying chatbot. Signal is always allowed on this device, even though as a group chat app with risk of cyberbullying we also recommend 14+ and/or parental guidance.",
      "default_enabled": false,
      "exempt_packages": [
        "com.whatsapp",
        "com.whatsapp.w4b"
      ],
      "allowed_domains": [
        "whatsapp.com",
        "whatsapp.net",
        "wa.me"
      ],
      "name_i18n": {
        "nl": "WhatsApp toestaan",
        "fr": "Autoriser WhatsApp"
      },
      "description_i18n": {
        "nl": "WhatsApp brengt privacyrisico's mee, heeft toxische socialemediafuncties en een vervelende chatbot. Signal is op dit toestel altijd toegelaten, al raden we ook daar 14+ en/of ouderlijke begeleiding aan: als groepschat-app draagt het een risico op cyberpesten.",
        "fr": "WhatsApp comporte des risques pour la vie priv\u00e9e, des fonctions de r\u00e9seau social toxiques et un chatbot p\u00e9nible. Signal est toujours autoris\u00e9 sur cet appareil, m\u00eame si nous y recommandons aussi 14+ et/ou un accompagnement parental : en tant qu'application de discussion de groupe, elle comporte un risque de cyberharc\u00e8lement."
      }
    },
    {
      "id": "youtube",
      "name": "Allow YouTube",
      "recommended_age": 16,
      "description": "YouTube's recommendation feed and Shorts are built to keep you watching, which is why it is blocked by default. Switching this on restores YouTube and its family (Kids, TV, Creator Studio, Music) and turns Google's own Restricted Mode on for the YouTube app and for the browser. The phone enforces that, so it cannot be switched off from inside YouTube. In herald, Shorts open as ordinary videos.",
      "default_enabled": false,
      "exempt_packages": [
        "com.google.android.youtube",
        "com.google.android.apps.youtube.kids",
        "com.google.android.youtube.tv",
        "com.google.android.apps.youtube.creator",
        "com.google.android.apps.youtube.unplugged",
        "com.google.android.apps.youtube.music"
      ],
      "allowed_domains": [
        "youtube.com",
        "youtu.be",
        "youtube-nocookie.com",
        "ytimg.com",
        "yt3.ggpht.com",
        "googlevideo.com",
        "youtubei.googleapis.com",
        "youtube.googleapis.com"
      ],
      "name_i18n": {
        "nl": "YouTube toestaan",
        "fr": "Autoriser YouTube"
      },
      "description_i18n": {
        "nl": "De aanbevelingsfeed en Shorts van YouTube zijn gemaakt om je te laten doorkijken, en daarom staat YouTube standaard uit. Zet je dit aan, dan komen YouTube en zijn familie terug (Kids, TV, Creator Studio, Music) en gaat Google's eigen Beperkte modus aan voor de YouTube-app en voor de browser. De telefoon dwingt dat af, dus het kan niet vanuit YouTube worden uitgezet. In herald openen Shorts als gewone video's.",
        "fr": "Le fil de recommandations et les Shorts de YouTube sont con\u00e7us pour vous garder devant l'\u00e9cran : c'est pourquoi YouTube est bloqu\u00e9 par d\u00e9faut. En activant ceci, YouTube et sa famille reviennent (Kids, TV, Creator Studio, Music) et le mode Restreint de Google s'active pour l'application YouTube et pour le navigateur. Le t\u00e9l\u00e9phone l'impose, il ne peut donc pas \u00eatre d\u00e9sactiv\u00e9 depuis YouTube. Dans herald, les Shorts s'ouvrent comme des vid\u00e9os ordinaires."
      }
    },
    {
      "id": "telegram",
      "name": "Allow Telegram",
      "recommended_age": 18,
      "description": "Telegram is a good messenger wrapped around a bad one. Private chats are fine. Public channels are searchable, effectively unmoderated, and are where adult material, extremist recruitment and pirated files live on this platform. There is no setting that removes them, and ordinary chats are not end-to-end encrypted unless you start a Secret Chat every time. Signal is always allowed on this device and does the messaging part better.",
      "default_enabled": false,
      "exempt_packages": [
        "org.telegram.messenger",
        "org.telegram.messenger.web",
        "org.thunderdog.challegram"
      ],
      "allowed_domains": [
        "telegram.org",
        "telegram.me",
        "t.me"
      ],
      "name_i18n": {
        "nl": "Telegram toestaan",
        "fr": "Autoriser Telegram"
      },
      "description_i18n": {
        "nl": "Telegram is een goede berichtenapp om een slechte heen. Priv\u00e9chats zijn prima. Publieke kanalen zijn doorzoekbaar, in de praktijk ongemodereerd, en het is daar dat pornografie, extremistische ronselarij en illegale bestanden op dit platform zitten. Er is geen instelling die ze weghaalt, en gewone chats zijn niet end-to-end versleuteld tenzij je telkens een Geheime chat begint. Signal mag altijd op dit toestel en doet het berichtendeel beter.",
        "fr": "Telegram est une bonne messagerie envelopp\u00e9e dans une mauvaise. Les conversations priv\u00e9es ne posent pas de probl\u00e8me. Les canaux publics sont consultables, dans les faits non mod\u00e9r\u00e9s, et c'est l\u00e0 que se trouvent la pornographie, le recrutement extr\u00e9miste et les fichiers pirat\u00e9s sur cette plateforme. Aucun r\u00e9glage ne les enl\u00e8ve, et les conversations ordinaires ne sont pas chiffr\u00e9es de bout en bout sauf \u00e0 ouvrir une conversation secr\u00e8te \u00e0 chaque fois. Signal est toujours autoris\u00e9 sur cet appareil et fait mieux la partie messagerie."
      }
    }
  ],
